# ═══════════════════════════════════════════════════
# COACH PERFECT — MOBILE SYNC SERVER ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── PORTS ───
# HTTP port for the PWA server (default: 3000)
PORT=3000

# WebSocket port for device sync (default: 3579)
WS_PORT=3579

# ─── SECURITY ───
# Shared secret that all syncing devices must include in their HELLO message.
# Generate with: openssl rand -hex 32
# Leave unset in development to allow unauthenticated connections.
SYNC_SECRET=your-random-secret-here

# ─── ENV ───
NODE_ENV=production

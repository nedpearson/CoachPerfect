{
  "name": "coachperfect-api",
  "version": "1.0.0",
  "description": "CoachPerfect API Server — document ingestion, notifications, AI agents, subscriptions",
  "main": "api-server.js",
  "scripts": {
    "start": "node api-server.js",
    "dev": "nodemon api-server.js",
    "billing": "node billing-server.js",
    "setup-stripe": "node -e \"require('./billing-server').app.listen(9999,()=>{}); fetch('http://localhost:9999/api/setup-stripe',{method:'POST'}).then(r=>r.json()).then(console.log)\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.14.2",
    "stripe": "^14.5.0",
    "better-sqlite3": "^9.2.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

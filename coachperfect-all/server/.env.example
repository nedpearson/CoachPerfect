# ═══════════════════════════════════════════════════
# COACH PERFECT — BILLING SERVER ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── STRIPE ───
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — created by running POST /api/setup-stripe
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BIZ_MONTHLY=price_...
STRIPE_PRICE_BIZ_ANNUAL=price_...
STRIPE_PRICE_ENT_MONTHLY=price_...

# ─── APP ───
# The URL of your frontend (used in Stripe redirect URLs and CORS)
FRONTEND_URL=https://coachperfect.io

# Port for the billing server (default: 3001)
BILLING_PORT=3001

# ─── SECURITY ───
# Random secret for the /api/setup-stripe endpoint (generate with: openssl rand -hex 32)
SETUP_SECRET=your-random-secret-here

# ─── EMAIL (optional) ───
# Get from https://resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=Coach Perfect <hello@coachperfect.io>
EMAIL_REPLY_TO=support@coachperfect.io

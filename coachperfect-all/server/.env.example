# ═══════════════════════════════════════════════════
# COACH PERFECT — SERVER ENV
# ═══════════════════════════════════════════════════
# Copy to .env and fill in real values.
# Never commit .env to git.

# ─── POSTGRESQL (local) ───
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=coachperfect
PG_USER=postgres
PG_PASSWORD=your_password_here
# Set to 'true' to require SSL (needed on hosted DBs, not local)
PG_SSL=false

# ─── JWT ───
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-64-char-random-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── PORTS ───
API_PORT=3002
BILLING_PORT=3001

# ─── APP ───
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ─── STRIPE ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BIZ_MONTHLY=price_...
STRIPE_PRICE_BIZ_ANNUAL=price_...
STRIPE_PRICE_ENT_MONTHLY=price_...

# ─── RESEND (email) ───
RESEND_API_KEY=re_...
EMAIL_FROM=Coach Perfect <hello@coachperfect.io>
EMAIL_REPLY_TO=support@coachperfect.io

# ─── OPENAI (AI session prep brief — professional+ plan) ───
OPENAI_API_KEY=sk-...

# ─── FALLBACK (dev only) ───
# Webhook emails go here when no DB record exists yet
FALLBACK_ADMIN_EMAIL=your@email.com

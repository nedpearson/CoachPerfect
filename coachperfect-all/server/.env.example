# ═══════════════════════════════════════════════════
# COACH PERFECT — BILLING SERVER ENV
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in real values.

# ─── STRIPE ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (created by /api/setup-stripe)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BIZ_MONTHLY=price_...
STRIPE_PRICE_BIZ_ANNUAL=price_...
STRIPE_PRICE_ENT_MONTHLY=price_...

# ─── RESEND (email) ───
RESEND_API_KEY=re_...
EMAIL_FROM=Coach Perfect <hello@coachperfect.io>
EMAIL_REPLY_TO=support@coachperfect.io

# ─── APP ───
FRONTEND_URL=https://coachperfect.io
BILLING_PORT=3001

# ─── FALLBACK (dev only) ───
# When DB is not connected, webhook emails go here
FALLBACK_ADMIN_EMAIL=your@email.com

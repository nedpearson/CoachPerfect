# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=3002
BILLING_PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── SECURITY ─────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=admin@coachperfect.io
ADMIN_PASS_HASH=change-this-to-bcrypt-hash

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite (default — file-based, zero config)
DB_PATH=./data/coachperfect.db

# Postgres (optional — uncomment for production scale)
# DATABASE_URL=postgresql://user:password@localhost:5432/coachperfect

# ─── FILE STORAGE ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
# Accepted: pdf,docx,xlsx,pptx,doc,xls,ppt,png,jpg,jpeg,gif,mp3,mp4,mov,wav,txt,csv,md,zip
ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,doc,xls,ppt,png,jpg,jpeg,gif,mp3,mp4,mov,wav,txt,csv,md,zip

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BIZ_MONTHLY=price_...
STRIPE_PRICE_BIZ_ANNUAL=price_...

# ─── AI / OPENAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4-turbo-preview
AI_ENABLED=false

# ─── EMAIL ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG....
EMAIL_FROM=noreply@coachperfect.io
EMAIL_FROM_NAME=CoachPerfect

# ─── WEBSOCKET ────────────────────────────────────────────────────────────────
WS_PORT=3579
WS_HEARTBEAT_MS=30000

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
UPLOAD_RATE_LIMIT_MAX=20
